APP_ENV=stage2a
STAGE2A_DISPOSABLE=1
STAGE2A_SYNTHETIC_ONLY=1
STAGE2A_STARTUP_PROFILE=CONTROLLED_ZERO_DOCUMENT_WRITES
MONGO_URL=mongodb://127.0.0.1:27029
DB_NAME=equinesync_stage2a_synthetic
STAGE2A_API_HOST=127.0.0.1
STAGE2A_API_PORT=8019
STAGE2A_MONGO_PORT=27029
ALLOW_AUTO_SEED=false
ALLOW_SEED_ROUTE=false
DISABLE_TASK_MATERIALIZER=true
DISABLE_NOTIFICATIONS=true
DISABLE_OWNER_DIGEST=true
DISABLE_OWNER_WEEKLY_RECAP=true
DISABLE_AUTO_NUDGES=true
DISABLE_SUBSCRIPTION_EMAIL_DISPATCHER=true
NO_PROXY=127.0.0.1,localhost
HTTP_PROXY=http://127.0.0.1:9
HTTPS_PROXY=http://127.0.0.1:9
ALL_PROXY=http://127.0.0.1:9
