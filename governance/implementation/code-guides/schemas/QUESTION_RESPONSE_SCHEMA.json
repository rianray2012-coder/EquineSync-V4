{
  "$defs": {
    "source_reference": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "minLength": 1,
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_type",
        "authority",
        "reference"
      ],
      "type": "object"
    },
    "supersession": {
      "additionalProperties": false,
      "properties": {
        "compatibility_treatment": {
          "type": "string"
        },
        "superseded_by": {
          "type": "string"
        },
        "supersedes": {
          "type": "string"
        }
      },
      "required": [
        "supersedes",
        "superseded_by",
        "compatibility_treatment"
      ],
      "type": "object"
    }
  },
  "$id": "https://equinesync.local/governance/implementation/code-guides/schemas/QUESTION_RESPONSE_SCHEMA.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "CGP-002 shared foundation schema. It defines structure, identifiers, evidence, authority, retained gaps, and activation-boundary metadata without creating EquineSync product policy.",
  "properties": {
    "answer": {
      "type": "string"
    },
    "answer_status": {
      "enum": [
        "UNANSWERED",
        "ANSWERED",
        "NOT_APPLICABLE",
        "BLOCKED_PENDING_DECISION",
        "DEFERRED"
      ],
      "type": "string"
    },
    "decision_reference": {
      "type": "string"
    },
    "governing_sources": {
      "items": {
        "$ref": "#/$defs/source_reference"
      },
      "type": "array"
    },
    "guide_id": {
      "pattern": "^ES-CG-(0[0-9]|1[0-3])$",
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "type": "string"
    },
    "question_id": {
      "pattern": "^ES-CG-(0[0-9]|1[0-3])-Q-\\d{4}$",
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "required": {
      "type": "boolean"
    },
    "schema_revision_notes": {
      "description": "Controlled extension notes. Substantive product policy is not encoded in CGP-002 schemas.",
      "type": "string"
    },
    "schema_revision_status": {
      "const": "CGP-002_FOUNDATION"
    },
    "schema_version": {
      "const": "0.2.0"
    }
  },
  "required": [
    "schema_version",
    "question_id",
    "guide_id",
    "question",
    "required",
    "answer_status",
    "rationale",
    "governing_sources"
  ],
  "schema_version": "0.2.0",
  "title": "Question Response Schema",
  "type": "object",
  "x-controlled-values-source": "governance/implementation/code-guides/schemas/CODE_GUIDE_CONTROLLED_VALUES.json",
  "x-source-prompt": "CGP-002"
}
