{
  "$defs": {
    "source_reference": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "minLength": 1,
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_type",
        "authority",
        "reference"
      ],
      "type": "object"
    },
    "supersession": {
      "additionalProperties": false,
      "properties": {
        "compatibility_treatment": {
          "type": "string"
        },
        "superseded_by": {
          "type": "string"
        },
        "supersedes": {
          "type": "string"
        }
      },
      "required": [
        "supersedes",
        "superseded_by",
        "compatibility_treatment"
      ],
      "type": "object"
    }
  },
  "$id": "https://equinesync.local/governance/implementation/code-guides/schemas/INVARIANT_SCHEMA.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "CGP-002 shared foundation schema. It defines structure, identifiers, evidence, authority, retained gaps, and activation-boundary metadata without creating EquineSync product policy.",
  "properties": {
    "affected_resources_or_actors": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "assurance_class": {
      "enum": [
        "A1_STANDARD",
        "A2_IMPORTANT",
        "A3_HIGH",
        "A4_CRITICAL"
      ],
      "type": "string"
    },
    "failure_severity": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "type": "string"
    },
    "governing_sources": {
      "items": {
        "$ref": "#/$defs/source_reference"
      },
      "type": "array"
    },
    "guide_id": {
      "pattern": "^ES-CG-(0[0-9]|1[0-3])$",
      "type": "string"
    },
    "invariant_id": {
      "pattern": "^ES-CG-(0[0-9]|1[0-3])-INV-\\d{4}$",
      "type": "string"
    },
    "protected_outcome": {
      "minLength": 1,
      "type": "string"
    },
    "required_evidence": {
      "enum": [
        "E0_ASSERTION",
        "E1_MANUAL_OBSERVATION",
        "E2_REPRODUCIBLE_LOCAL",
        "E3_INDEPENDENT_CI",
        "E4_CONTROLLED_ENVIRONMENT",
        "E5_PRODUCTION"
      ],
      "type": "string"
    },
    "schema_revision_notes": {
      "description": "Controlled extension notes. Substantive product policy is not encoded in CGP-002 schemas.",
      "type": "string"
    },
    "schema_revision_status": {
      "const": "CGP-002_FOUNDATION"
    },
    "schema_version": {
      "const": "0.2.0"
    },
    "statement": {
      "minLength": 1,
      "type": "string"
    },
    "verification_methods": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "invariant_id",
    "guide_id",
    "statement",
    "protected_outcome",
    "affected_resources_or_actors",
    "governing_sources",
    "verification_methods",
    "required_evidence",
    "assurance_class",
    "failure_severity"
  ],
  "schema_version": "0.2.0",
  "title": "Invariant Schema",
  "type": "object",
  "x-controlled-values-source": "governance/implementation/code-guides/schemas/CODE_GUIDE_CONTROLLED_VALUES.json",
  "x-source-prompt": "CGP-002"
}
