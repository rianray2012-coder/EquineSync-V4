{
  "$defs": {
    "source_reference": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "minLength": 1,
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_type",
        "authority",
        "reference"
      ],
      "type": "object"
    },
    "supersession": {
      "additionalProperties": false,
      "properties": {
        "compatibility_treatment": {
          "type": "string"
        },
        "superseded_by": {
          "type": "string"
        },
        "supersedes": {
          "type": "string"
        }
      },
      "required": [
        "supersedes",
        "superseded_by",
        "compatibility_treatment"
      ],
      "type": "object"
    }
  },
  "$id": "https://equinesync.local/governance/implementation/code-guides/schemas/IMPLEMENTATION_EVIDENCE_SCHEMA.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "CGP-002 shared foundation schema. It defines structure, identifiers, evidence, authority, retained gaps, and activation-boundary metadata without creating EquineSync product policy.",
  "properties": {
    "artifact_path": {
      "minLength": 1,
      "type": "string"
    },
    "atlas_task_id": {
      "type": "string"
    },
    "commit_sha": {
      "type": "string"
    },
    "control_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "environment": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_grade": {
      "enum": [
        "E0_ASSERTION",
        "E1_MANUAL_OBSERVATION",
        "E2_REPRODUCIBLE_LOCAL",
        "E3_INDEPENDENT_CI",
        "E4_CONTROLLED_ENVIRONMENT",
        "E5_PRODUCTION"
      ],
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^CGEVID-\\d{4}$",
      "type": "string"
    },
    "evidence_type": {
      "minLength": 1,
      "type": "string"
    },
    "guide_id": {
      "pattern": "^ES-CG-(0[0-9]|1[0-3])$",
      "type": "string"
    },
    "result": {
      "minLength": 1,
      "type": "string"
    },
    "retained_gates": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "reviewer": {
      "minLength": 1,
      "type": "string"
    },
    "schema_revision_notes": {
      "description": "Controlled extension notes. Substantive product policy is not encoded in CGP-002 schemas.",
      "type": "string"
    },
    "schema_revision_status": {
      "const": "CGP-002_FOUNDATION"
    },
    "schema_version": {
      "const": "0.2.0"
    },
    "status": {
      "enum": [
        "REQUIRED",
        "OPTIONAL",
        "NOT_APPLICABLE",
        "NOT_YET_APPLICABLE",
        "PLANNED",
        "PARTIAL",
        "COMPLETE",
        "VERIFIED",
        "STALE",
        "INVALID",
        "MISSING"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "guide_id",
    "control_ids",
    "evidence_type",
    "evidence_grade",
    "environment",
    "artifact_path",
    "commit_sha",
    "result",
    "reviewer",
    "status",
    "retained_gates"
  ],
  "schema_version": "0.2.0",
  "title": "Implementation Evidence Schema",
  "type": "object",
  "x-controlled-values-source": "governance/implementation/code-guides/schemas/CODE_GUIDE_CONTROLLED_VALUES.json",
  "x-source-prompt": "CGP-002"
}
