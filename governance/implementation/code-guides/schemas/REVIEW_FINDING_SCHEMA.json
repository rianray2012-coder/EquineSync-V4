{
  "$defs": {
    "source_reference": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "minLength": 1,
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_type",
        "authority",
        "reference"
      ],
      "type": "object"
    },
    "supersession": {
      "additionalProperties": false,
      "properties": {
        "compatibility_treatment": {
          "type": "string"
        },
        "superseded_by": {
          "type": "string"
        },
        "supersedes": {
          "type": "string"
        }
      },
      "required": [
        "supersedes",
        "superseded_by",
        "compatibility_treatment"
      ],
      "type": "object"
    }
  },
  "$id": "https://equinesync.local/governance/implementation/code-guides/schemas/REVIEW_FINDING_SCHEMA.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "CGP-002 shared foundation schema. It defines structure, identifiers, evidence, authority, retained gaps, and activation-boundary metadata without creating EquineSync product policy.",
  "properties": {
    "affected_atlas_tasks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "affected_controls": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "closure_evidence": {
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "disposition_authority": {
      "minLength": 1,
      "type": "string"
    },
    "evidence": {
      "minLength": 1,
      "type": "string"
    },
    "finding_id": {
      "pattern": "^CGFIND-\\d{4}$",
      "type": "string"
    },
    "guide_id": {
      "pattern": "^ES-CG-(0[0-9]|1[0-3])$",
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "required_action": {
      "minLength": 1,
      "type": "string"
    },
    "retained_reason": {
      "type": "string"
    },
    "review_type": {
      "minLength": 1,
      "type": "string"
    },
    "schema_revision_notes": {
      "description": "Controlled extension notes. Substantive product policy is not encoded in CGP-002 schemas.",
      "type": "string"
    },
    "schema_revision_status": {
      "const": "CGP-002_FOUNDATION"
    },
    "schema_version": {
      "const": "0.2.0"
    },
    "severity": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "REQUIRED",
        "OPTIONAL",
        "NOT_APPLICABLE",
        "NOT_YET_APPLICABLE",
        "PLANNED",
        "PARTIAL",
        "COMPLETE",
        "VERIFIED",
        "STALE",
        "INVALID",
        "MISSING"
      ],
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "finding_id",
    "guide_id",
    "review_type",
    "severity",
    "title",
    "description",
    "evidence",
    "status",
    "required_action",
    "disposition_authority"
  ],
  "schema_version": "0.2.0",
  "title": "Review Finding Schema",
  "type": "object",
  "x-controlled-values-source": "governance/implementation/code-guides/schemas/CODE_GUIDE_CONTROLLED_VALUES.json",
  "x-source-prompt": "CGP-002"
}
