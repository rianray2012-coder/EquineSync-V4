  "$id": "https://equinesync.local/governance/implementation/code-guides/schemas/EXCEPTION_RECORD_SCHEMA.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "CGP-002 shared foundation schema. It defines structure, identifiers, evidence, authority, retained gaps, and activation-boundary metadata without creating EquineSync product policy.",
  "properties": {
    "affected_controls": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "approval_authority": {
      "minLength": 1,
      "type": "string"
    },
    "approved_date": {
      "type": "string"
    },
    "compensating_controls": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "exception_id": {
      "pattern": "^CGEXC-\\d{4}$",
      "type": "string"
    },
    "expiration_date": {
      "minLength": 1,
      "type": "string"
    },
    "guide_id": {
      "pattern": "^ES-CG-(0[0-9]|1[0-3])$",
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "remediation": {
      "minLength": 1,
      "type": "string"
    },
    "risk": {
      "type": "string"
    },
    "schema_revision_notes": {
      "description": "Controlled extension notes. Substantive product policy is not encoded in CGP-002 schemas.",
      "type": "string"
    },
    "schema_revision_status": {
      "const": "CGP-002_FOUNDATION"
    },
    "schema_version": {
      "const": "0.2.0"
    },
    "status": {
      "enum": [
        "REQUIRED",
        "OPTIONAL",
        "NOT_APPLICABLE",
        "NOT_YET_APPLICABLE",
        "PLANNED",
        "PARTIAL",
        "COMPLETE",
        "VERIFIED",
        "STALE",
        "INVALID",
        "MISSING"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "exception_id",
    "guide_id",
    "affected_controls",
    "owner",
    "approval_authority",
    "status",
    "expiration_date",
    "compensating_controls",
    "remediation"
  ],
  "schema_version": "0.2.0",
  "title": "Exception Record Schema",
  "type": "object",
  "x-controlled-values-source": "governance/implementation/code-guides/schemas/CODE_GUIDE_CONTROLLED_VALUES.json",
  "x-source-prompt": "CGP-002"
}
