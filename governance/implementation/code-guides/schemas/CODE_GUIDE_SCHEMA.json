{
  "$defs": {
    "source_reference": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "minLength": 1,
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_type",
        "authority",
        "reference"
      ],
      "type": "object"
    },
    "supersession": {
      "additionalProperties": false,
      "properties": {
        "compatibility_treatment": {
          "type": "string"
        },
        "superseded_by": {
          "type": "string"
        },
        "supersedes": {
          "type": "string"
        }
      },
      "required": [
        "supersedes",
        "superseded_by",
        "compatibility_treatment"
      ],
      "type": "object"
    }
  },
  "$id": "https://equinesync.local/governance/implementation/code-guides/schemas/CODE_GUIDE_SCHEMA.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "CGP-002 shared foundation schema. It defines structure, identifiers, evidence, authority, retained gaps, and activation-boundary metadata without creating EquineSync product policy.",
  "properties": {
    "activation_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "assurance_class": {
      "enum": [
        "A1_STANDARD",
        "A2_IMPORTANT",
        "A3_HIGH",
        "A4_CRITICAL"
      ],
      "type": "string"
    },
    "control_families": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "governing_sources": {
      "items": {
        "$ref": "#/$defs/source_reference"
      },
      "type": "array"
    },
    "guide_id": {
      "pattern": "^ES-CG-(0[0-9]|1[0-3])$",
      "type": "string"
    },
    "guide_title": {
      "minLength": 1,
      "type": "string"
    },
    "machine_readable_companions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "maturity_state": {
      "enum": [
        "PLANNED",
        "CHARTERED",
        "SOURCE_FROZEN",
        "CURRENT_STATE_ASSESSED",
        "DRAFTING",
        "INTERNAL_REVIEW",
        "TECHNICAL_REVIEW",
        "PRODUCT_REVIEW",
        "CROSS_GUIDE_REVIEW",
        "ADVERSARIAL_REVIEW",
        "SCENARIO_VALIDATED",
        "ASSURANCE_REVIEW",
        "ADOPTION_CANDIDATE",
        "ADOPTED",
        "REPOSITORY_ACCESSIONED",
        "ACTIVE",
        "REVISION_PENDING",
        "SUPERSEDED",
        "RETIRED",
        "BLOCKED"
      ],
      "type": "string"
    },
    "non_authorization_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "related_atlases": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "related_guides": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "related_pias": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "required_reviews": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "risk_domains": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "schema_revision_notes": {
      "description": "Controlled extension notes. Substantive product policy is not encoded in CGP-002 schemas.",
      "type": "string"
    },
    "schema_revision_status": {
      "const": "CGP-002_FOUNDATION"
    },
    "schema_version": {
      "const": "0.2.0"
    },
    "supported_environments": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "supported_platforms": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9_.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "guide_id",
    "guide_title",
    "version",
    "maturity_state",
    "assurance_class",
    "risk_domains",
    "governing_sources",
    "related_guides",
    "related_pias",
    "related_atlases",
    "control_families",
    "supported_platforms",
    "supported_environments",
    "required_reviews",
    "non_authorization_boundary",
    "machine_readable_companions",
    "activation_boundary"
  ],
  "schema_version": "0.2.0",
  "title": "Code Guide Schema",
  "type": "object",
  "x-controlled-values-source": "governance/implementation/code-guides/schemas/CODE_GUIDE_CONTROLLED_VALUES.json",
  "x-source-prompt": "CGP-002"
}
