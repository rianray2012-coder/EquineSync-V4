{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "requested_custom_agent_name", "child_identifier", "child_response"],
  "properties": {
    "run_id": {"type": "string", "const": "FORA-REMEDIATION-2026-001"},
    "requested_custom_agent_name": {"type": "string"},
    "child_identifier": {"type": "string"},
    "child_response": {"$ref": "#/$defs/childResponse"}
  },
  "$defs": {
    "childResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_agent_name", "es_ra_role", "registration_marker", "role_prompt_path",
        "shared_framework_paths", "expected_sandbox", "authorized_capabilities",
        "prohibited_capabilities", "custom_instruction_layer_acknowledged", "calibration_only",
        "substantive_work_performed", "files_written", "network_used"
      ],
      "properties": {
        "declared_agent_name": {"type": "string"},
        "es_ra_role": {"type": "string", "pattern": "^ES-RA-[0-9]{2}$"},
        "registration_marker": {"type": "string", "pattern": "^ES-RA-[0-9]{2}-REGISTERED-V[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "role_prompt_path": {"type": "string"},
        "shared_framework_paths": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "expected_sandbox": {"type": "string", "const": "read-only"},
        "authorized_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "prohibited_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "custom_instruction_layer_acknowledged": {"type": "boolean", "const": true},
        "calibration_only": {"type": "boolean", "const": true},
        "substantive_work_performed": {"type": "boolean", "const": false},
        "files_written": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
        "network_used": {"type": "boolean", "const": false}
      }
    }
  }
}
