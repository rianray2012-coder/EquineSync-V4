{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["test_id", "batch_id", "parent_sandbox", "configured_max_threads", "configured_max_depth", "results"],
  "properties": {
    "test_id": {"type": "string"},
    "batch_id": {"type": "string"},
    "parent_sandbox": {"type": "string", "enum": ["read-only", "workspace-write"]},
    "configured_max_threads": {"type": "integer"},
    "configured_max_depth": {"type": "integer"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requested_custom_agent_name", "child_identifier", "es_ra_role", "registration_marker", "expected_sandbox", "custom_instruction_layer_acknowledged", "calibration_only", "substantive_work_performed", "files_written", "network_used"],
        "properties": {
          "requested_custom_agent_name": {"type": "string"},
          "child_identifier": {"type": "string"},
          "es_ra_role": {"type": "string", "pattern": "^ES-RA-[0-9]{2}$"},
          "registration_marker": {"type": "string", "pattern": "^ES-RA-[0-9]{2}-REGISTERED-V[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "expected_sandbox": {"type": "string", "enum": ["read-only", "workspace-write"]},
          "custom_instruction_layer_acknowledged": {"type": "boolean", "const": true},
          "calibration_only": {"type": "boolean", "const": true},
          "substantive_work_performed": {"type": "boolean", "const": false},
          "files_written": {"type": "array", "items": {"type": "string"}},
          "network_used": {"type": "boolean", "const": false}
        }
      }
    }
  }
}
