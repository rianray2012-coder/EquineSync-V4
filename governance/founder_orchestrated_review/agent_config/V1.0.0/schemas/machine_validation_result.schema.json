{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EquineSync Machine Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_cycle_id",
    "agent_run_id",
    "package_id",
    "environment",
    "checks",
    "summary",
    "recommended_disposition"
  ],
  "properties": {
    "review_cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_run_id": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string"
    },
    "environment": {
      "type": "object"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exit_code"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "started_at": {
            "type": "string"
          },
          "ended_at": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "stdout_evidence_id": {
            "type": "string"
          },
          "stderr_evidence_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "description",
          "status"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASSED",
              "FAILED",
              "WARNING",
              "SKIPPED",
              "BLOCKED",
              "NOT_APPLICABLE",
              "NOT_EXECUTED",
              "TOOL_FAILURE",
              "NONDETERMINISTIC"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "recommended_disposition": {
      "type": "string",
      "minLength": 1
    }
  }
}
