{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EquineSync Review Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_cycle_id",
    "authorized_by",
    "authorization_date",
    "review_object",
    "requested_gate",
    "assigned_agents",
    "scope",
    "prohibited_actions"
  ],
  "properties": {
    "review_cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "authorized_by": {
      "type": "string",
      "minLength": 1
    },
    "authorization_date": {
      "type": "string",
      "format": "date-time"
    },
    "review_object": {
      "type": "string",
      "minLength": 1
    },
    "requested_gate": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string"
    },
    "repository_commit": {
      "type": "string"
    },
    "package_hash": {
      "type": "string"
    },
    "assigned_agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "permitted_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "permitted_environments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "prohibited_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "founder_decisions_reserved": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    }
  }
}
