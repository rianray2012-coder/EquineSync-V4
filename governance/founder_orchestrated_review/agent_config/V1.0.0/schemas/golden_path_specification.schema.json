{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EquineSync Golden-Path Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_cycle_id",
    "specification_id",
    "title",
    "purpose",
    "governing_requirements",
    "actors",
    "environment_assumptions",
    "steps",
    "pass_criteria",
    "failure_criteria",
    "cleanup"
  ],
  "properties": {
    "review_cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "specification_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "governing_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "actor_id",
          "role"
        ],
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fixture_id",
          "type"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": [
              "string",
              "integer"
            ]
          },
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "environment_assumptions": {
      "type": "object"
    },
    "configuration": {
      "type": "object"
    },
    "initial_state": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_number",
          "action",
          "expected_result",
          "oracle",
          "evidence_required"
        ],
        "properties": {
          "step_number": {
            "type": "integer",
            "minimum": 1
          },
          "actor_id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "expected_result": {
            "type": "string",
            "minLength": 1
          },
          "expected_state": {
            "type": "object"
          },
          "oracle": {
            "type": "object",
            "required": [
              "type",
              "authority"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "authority": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "evidence_required": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "timing_tolerance": {
            "type": "string"
          },
          "idempotency_expectation": {
            "type": "string"
          }
        }
      }
    },
    "pass_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "failure_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cleanup": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "execution_prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
