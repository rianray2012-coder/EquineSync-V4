{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EquineSync Work Completeness Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_cycle_id",
    "agent_run_id",
    "items"
  ],
  "properties": {
    "review_cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_run_id": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "work_item_id",
          "description",
          "procedure",
          "status"
        ],
        "properties": {
          "work_item_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "authorization_reference": {
            "type": "string"
          },
          "procedure": {
            "type": "string",
            "minLength": 1
          },
          "input_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "output_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "COMPLETED",
              "COMPLETED_WITH_LIMITATION",
              "SAMPLED",
              "NOT_APPLICABLE",
              "OUT_OF_SCOPE",
              "BLOCKED",
              "UNAVAILABLE",
              "CONFLICTED",
              "DEFERRED_BY_FOUNDER",
              "NOT_REVIEWED"
            ]
          },
          "limitation": {
            "type": "string"
          },
          "unresolved_matter": {
            "type": "string"
          },
          "verification_required": {
            "type": "boolean"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
