{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EquineSync Founder Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "review_cycle_id",
    "founder",
    "decision_date",
    "decision_type",
    "decision",
    "affected_items"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "review_cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "founder": {
      "const": "Rian Ray"
    },
    "decision_date": {
      "type": "string",
      "format": "date-time"
    },
    "decision_type": {
      "enum": [
        "APPROVE_REMEDIATION",
        "RETURN_FOR_REDRAFT",
        "AUTHORIZE_REVIEW_CYCLE",
        "ACCEPT_RISK",
        "RETAIN_NONBLOCKING_FINDING",
        "ADOPT_NOT_LOCKED",
        "AUTHORIZE_LOCK",
        "AUTHORIZE_IMPLEMENTATION",
        "AUTHORIZE_PILOT",
        "AUTHORIZE_RELEASE",
        "REJECT",
        "DEFER",
        "REOPEN_REVIEW",
        "OTHER"
      ]
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "affected_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "expiration_or_revalidation_trigger": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "signature_or_record_reference": {
      "type": "string"
    }
  }
}
