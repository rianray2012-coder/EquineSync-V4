{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EquineSync Findings Register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_cycle_id",
    "findings"
  ],
  "properties": {
    "review_cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "originating_agent_run_id",
          "title",
          "severity",
          "substantiation",
          "status",
          "observed_condition",
          "expected_condition",
          "verification_criteria"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "originating_agent_run_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "affected_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "severity": {
            "enum": [
              "P0_CRITICAL",
              "P1_BLOCKING",
              "P2_NONBLOCKING",
              "OBSERVATION",
              "FOUNDER_DECISION_REQUIRED"
            ]
          },
          "substantiation": {
            "enum": [
              "CANDIDATE_FINDING",
              "SUBSTANTIATED",
              "REPRODUCED",
              "CORROBORATED",
              "DISPUTED",
              "UNSUBSTANTIATED",
              "WITHDRAWN_WITH_HISTORY",
              "FOUNDER_DISPOSITIONED"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "UNDER_ANALYSIS",
              "REMEDIATION_PROPOSED",
              "REMEDIATION_IN_PROGRESS",
              "REMEDIATED_UNVERIFIED",
              "VERIFICATION_FAILED",
              "VERIFIED_CLOSED",
              "REOPENED",
              "DUPLICATE_RECOMMENDED",
              "OUT_OF_SCOPE_RECOMMENDED",
              "SUPERSEDED",
              "RETAINED_NONBLOCKING",
              "FOUNDER_ACCEPTED_RISK",
              "FOUNDER_REJECTED_FINDING"
            ]
          },
          "observed_condition": {
            "type": "string",
            "minLength": 1
          },
          "expected_condition": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "severity_rationale": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MODERATE",
              "LOW",
              "UNRESOLVED"
            ]
          },
          "likelihood": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "affected_domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "root_cause": {
            "type": "string"
          },
          "required_remediation": {
            "type": "string"
          },
          "verification_criteria": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "residual_risk": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "due_gate": {
            "type": "string"
          },
          "founder_disposition": {
            "type": "string"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "timestamp",
                "action"
              ],
              "properties": {
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "actor": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}
