# EquineSync local environment example
# Copy to an ignored local .env file and replace placeholders locally.
# Do not commit real credentials or provider secrets.

APP_ENV=development
RATE_LIMIT_ENABLED=false
PUBLIC_FRONTEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
MONGO_URL=mongodb://localhost:27017
DB_NAME=equinesync_local
JWT_SECRET=replace-with-local-development-value

# Draft-only AI extraction backend settings. Never commit real values.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
AI_STORAGE_ENDPOINT_URL=
AI_STORAGE_REGION=auto
AI_STORAGE_BUCKET=
AI_STORAGE_ACCESS_KEY_ID=
AI_STORAGE_SECRET_ACCESS_KEY=
