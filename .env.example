# EquineSync local environment example
# Copy to an ignored local .env file and replace placeholders locally.
# Do not commit real credentials or provider secrets.

APP_ENV=development
RATE_LIMIT_ENABLED=false
PUBLIC_FRONTEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
MONGO_URL=mongodb://localhost:27017
DB_NAME=equinesync_local
JWT_SECRET=replace-with-local-development-value
