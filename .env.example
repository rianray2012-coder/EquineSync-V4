# EquineSync local environment example
# Copy to an ignored local .env file and replace placeholders locally.
# Do not commit real credentials or provider secrets.

APP_ENV=development
RATE_LIMIT_ENABLED=false
PUBLIC_FRONTEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
WEBSITE_URL=https://equine-sync.com
EMAIL_LOGO_URL=http://localhost:3000/icon-192.png
APP_DOWNLOAD_URL=http://localhost:3000
MOBILE_APP_DOWNLOAD_URL=
CORS_ORIGINS=http://localhost:3000
MONGO_URL=mongodb://localhost:27017
DB_NAME=equinesync_local
JWT_SECRET=replace-with-local-development-value
