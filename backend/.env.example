# Backend local environment example
# Copy to backend/.env or another ignored local env file.
# Values here are placeholders only; do not commit real secrets.

APP_ENV=development
RATE_LIMIT_ENABLED=false
MONGO_URL=mongodb://localhost:27017
DB_NAME=equinesync_local
PUBLIC_FRONTEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-local-development-value
STRIPE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_WEBHOOK_ENDPOINT_URL=
STRIPE_LIVE_CHECKOUT_ENABLED=false
STRIPE_LIVE_PORTAL_ENABLED=false
STRIPE_LIVE_FOUNDER_CHECKOUT_PROOF_ENABLED=false
# Stripe Price overrides follow STRIPE_PRICE_<PLAN>_<MONTHLY|SIX_MONTH|ANNUAL>
# (see docs/PHASE_15A_ENV_PLACEHOLDERS.md). Monthly/annual IDs default to the
# live catalog map in core/billing_provisioning.py. The D-14 six-month Prices
# (interval=month, interval_count=6) are required in production once created.
STRIPE_PRICE_ADVANCED_BARN_SIX_MONTH=
STRIPE_PRICE_TRAINER_LESSON_50_SIX_MONTH=
RESEND_API_KEY=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_AUTH_SERVER=
DOCUSIGN_PRIVATE_KEY_PATH=

# Draft-only AI extraction. Provider secrets belong only in backend/runtime env.
# This pipeline stages private sources and returns human-review drafts only.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
AI_STORAGE_ENDPOINT_URL=
AI_STORAGE_REGION=auto
AI_STORAGE_BUCKET=
AI_STORAGE_ACCESS_KEY_ID=
AI_STORAGE_SECRET_ACCESS_KEY=
