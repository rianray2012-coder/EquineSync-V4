# Backend local environment example
# Copy to backend/.env or another ignored local env file.
# Values here are placeholders only; do not commit real secrets.

APP_ENV=development
RATE_LIMIT_ENABLED=false
MONGO_URL=mongodb://localhost:27017
DB_NAME=equinesync_local
PUBLIC_FRONTEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-local-development-value
STRIPE_SECRET_KEY=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CATALOG_ENVIRONMENT=sandbox
SKIP_STRIPE_CATALOG_PROVISIONING=true
STRIPE_CATALOG_AUTOPROVISION_ON_STARTUP=false
RESEND_API_KEY=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_AUTH_SERVER=
DOCUSIGN_PRIVATE_KEY_PATH=
