EMAIL_LOGO_URL=http://localhost:3000/icon-192.png
APP_DOWNLOAD_URL=http://localhost:3000
MOBILE_APP_DOWNLOAD_URL=
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-local-development-value
STRIPE_SECRET_KEY=
