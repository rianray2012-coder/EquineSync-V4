# EquineSync native app public configuration.
# Values prefixed with EXPO_PUBLIC_ are bundled into the app.
# Do not place secrets, provider credentials, tokens, private keys, or webhook
# secrets in this file.

EXPO_PUBLIC_APP_ENV=native-dev
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional public Sentry DSN for native crash/error monitoring.
# Leave blank until the EquineSync Sentry mobile project is created.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=native-dev
EXPO_PUBLIC_SENTRY_RELEASE=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2
EXPO_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
EXPO_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1
